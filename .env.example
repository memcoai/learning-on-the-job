# Copy to .env and fill in. The harness loads this file on start-up.

# --- Memco Memory MCP ---------------------------------------------------------
# Endpoint of the Memco Memory MCP. No default is baked into the code; the
# harness will not run without it unless --no-memory.
MEMCO_MCP_URL=
# Sent as an Authorization: Bearer header. Leave blank if your endpoint accepts
# unauthenticated connections.
MEMCO_MCP_TOKEN=
# The memory domain every call is scoped to. Defaults to "knowledge", the store
# for facts and procedures, which is where the order-desk lessons belong. Your
# token must have it enabled: call list_domains on the endpoint to check.
MEMCO_MCP_DOMAIN=knowledge

# Every read and write is tagged topic="memco-lotj" and nothing else, so a trial
# neither reads your real memories nor leaves its invented policies where your
# own searches will find them. The topic is not configurable: it is a hard
# filter, and a run whose reads and writes disagreed on it would look exactly
# like an agent that never learns.
#
# That fences a trial off, but does not reset it: lessons persist under that
# topic between runs, so a fresh trial still needs a fresh workspace. The
# harness never creates, resets, or wipes one; point it at one you have prepared.

# --- LLM providers ------------------------------------------------------------
# Each role below names its model as provider:model, and roles may sit on
# different providers in the same run. Two provider prefixes exist:
#   anthropic:  the Anthropic API, using ANTHROPIC_API_KEY
#   openai:     any OpenAI-compatible endpoint (OpenAI itself, Mistral,
#               self-hosted servers), using OPENAI_API_KEY and OPENAI_BASE_URL
# Keys are read only for the providers actually named by a role.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Defaults to the OpenAI endpoint. Mistral, for example: https://api.mistral.ai/v1
# One base URL per run: all openai: roles share it, so mixing two different
# OpenAI-compatible vendors in one run is not supported (Anthropic + one
# compatible vendor is).
OPENAI_BASE_URL=

# --- Models -------------------------------------------------------------------
# A mid-tier model does the drafting; a cheaper one does review and reflection.
# Mix providers freely, e.g. AGENT_MODEL=anthropic:claude-sonnet-5 with
# REVIEWER_MODEL=openai:gpt-5-mini, or run everything on one provider
# (all-Mistral: openai:mistral-large-latest / openai:mistral-small-latest with
# OPENAI_BASE_URL set to Mistral's endpoint).
AGENT_MODEL=anthropic:claude-sonnet-5
REVIEWER_MODEL=anthropic:claude-haiku-4-5
REFLECTION_MODEL=anthropic:claude-haiku-4-5

# OpenAI
# AGENT_MODEL=openai:gpt-5.6-luna
# REVIEWER_MODEL=openai:gpt-5.6-luna
# REFLECTION_MODEL=openai:gpt-5.6-luna